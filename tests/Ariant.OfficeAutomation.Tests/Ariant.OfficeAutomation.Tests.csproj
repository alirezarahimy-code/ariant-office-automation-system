    آزمون‌های صحت تقویم شمسی با بردارهای مرجع، و آزمون‌های لایه کاربرد.
  -->
  <PropertyGroup>
    <RootNamespace>Ariant.OfficeAutomation.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
