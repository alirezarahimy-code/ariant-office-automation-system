# ===== هویت و امنیت =====
DJANGO_SECRET_KEY=CHANGE-ME-random-64-chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=automation.example.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://automation.example.ir
PLATFORM_ORG_NAME=سازمان آرینت
PLATFORM_ORG_MOTTO=اتوماسیون اداری یکپارچه

# ===== پایگاه‌داده =====
DB_ENGINE=postgresql        # یا mysql — پشتیبانی داخلی فاز ۰
POSTGRES_DB=ariant
POSTGRES_USER=ariant
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ===== ایمیل (اعلان‌های فاز ۲) =====
NOTIFY_EMAIL=0
EMAIL_HOST=smtp.example.ir
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=automation@example.ir

# ===== پل سامانه تیکتینگ =====
TICKET_BRIDGE_URL=https://ticket.example.ir
TICKET_BRIDGE_SSO_KEY=ROTATE-ME-shared-hmac-key
# دسترسی فقط‌خواندنی (کاربر با تنها SELECT روی tickets/users)
TICKET_DB_HOST=127.0.0.1
TICKET_DB_PORT=3306
TICKET_DB_NAME=persian_ticketing
TICKET_DB_USER=readonly_user
TICKET_DB_PASSWORD=CHANGE-ME

# ===== عملیات =====
SECRETARIAT_DEADLINE_WARNING_DAYS=3

# ===== اعلان چندکاناله (فاز ۲) =====
PLATFORM_NAME=سامانه اتوماسیون اداری آرینت
SMS_ENABLED=0
SMS_BACKEND=apps.core.sms.ConsoleSMSBackend   # تولید: apps.core.sms.RestSMSBackend
SMS_FROM=
SMS_API_URL=
SMS_API_KEY=

# ===== حالت زیرسامانه تیکتینگ (فاز ۲) =====
# bridge = آینه خواندنی + پل به PHP (پیش‌فرض دوران گذار)
# native = چرخه کامل تیکت بومی روی بستر
TICKET_MODE=bridge

# ===== پیام‌رسان سازمانی — بله/ایتا (فاز ۳) =====
NOTIFICATIONS_BALE_ENABLED=0
NOTIFICATIONS_ITA_ENABLED=0
CHAT_BALE_BACKEND=apps.core.notify_channels.ConsoleChatBackend   # تولید: apps.core.notify_channels.RestChatBackend
CHAT_ITA_BACKEND=apps.core.notify_channels.ConsoleChatBackend
CHAT_API_URL=
CHAT_API_TOKEN=

# ===== ورود سازمانی LDAP / Active Directory (فاز ۳ — اختیاری) =====
AUTH_LDAP_ENABLED=0
LDAP_URI=
LDAP_BASE_DN=
LDAP_USER_DN=uid={username},ou=people,{base}

# ===== گزارش‌ساز (فاز ۳) =====
# فونت TTF فارسی برای خروجی PDF گزارش‌ها (در غیر این صورت نسخه چاپی)
REPORTS_PDF_FONT=
