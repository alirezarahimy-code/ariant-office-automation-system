[Unit]
Description=Ariant Office Automation (Django/Gunicorn)
After=network.target postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/ariant/backend
EnvironmentFile=/etc/ariant.env
ExecStart=/opt/ariant/backend/.venv/bin/gunicorn config.wsgi:application \
  --workers 3 --threads 2 --bind 127.0.0.1:8000 \
  --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
