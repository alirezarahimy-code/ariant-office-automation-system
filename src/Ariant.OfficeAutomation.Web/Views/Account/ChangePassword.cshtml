@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغییر گذرواژه";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">تغییر گذرواژه</h1>
        <p class="page-head__subtitle">برای امنیت حساب، گذرواژه‌ای قوی انتخاب کنید</p>
    </div>
</div>

<div class="card card--narrow">
    <form asp-action="ChangePassword" method="post" class="form">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] is not null)
        {
            <div class="alert alert--danger" role="alert">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="form__row">
            <label class="form__label" asp-for="CurrentPassword"></label>
            <input class="form__input" asp-for="CurrentPassword" type="password" dir="ltr" autocomplete="current-password" />
            <span class="form__error" asp-validation-for="CurrentPassword"></span>
        </div>

        <div class="form__row">
            <label class="form__label" asp-for="NewPassword"></label>
            <input class="form__input" asp-for="NewPassword" type="password" dir="ltr" autocomplete="new-password" />
            <span class="form__hint">حداقل ۸ نویسه، شامل حرف بزرگ، حرف کوچک، رقم و نویسه ویژه.</span>
            <span class="form__error" asp-validation-for="NewPassword"></span>
        </div>

        <div class="form__row">
            <label class="form__label" asp-for="ConfirmPassword"></label>
            <input class="form__input" asp-for="ConfirmPassword" type="password" dir="ltr" autocomplete="new-password" />
            <span class="form__error" asp-validation-for="ConfirmPassword"></span>
        </div>

        <div class="form__actions">
            <button type="submit" class="btn btn--primary">ذخیره گذرواژه جدید</button>
            <a class="btn btn--ghost" asp-controller="Home" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
